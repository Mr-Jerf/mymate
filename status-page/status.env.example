# Copy to status.env on the status-page host and chmod 600 status.env.
# Never commit the copied file or share these values.
STATUS_BRAND_NAME=Example ISP
STATUS_SUBTITLE=Live service health
STATUS_POLL_MS=30000
MYMATE_API_URL=https://mymate.example.com
# Must exactly match MyMate's STATUS_API_TOKEN. Generate a separate token for this integration.
MYMATE_STATUS_TOKEN=replace-with-a-random-64-character-hex-token
